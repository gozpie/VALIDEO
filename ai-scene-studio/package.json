{
  "name": "ai-scene-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Plateforme de conception d'images et vidéos IA pilotée par une scène 3D persistante.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/web run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @ass/web run test:e2e",
    "schema:generate": "pnpm --filter @ass/scene-schema run generate",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "api:generate": "uv run python -m ass_api.cli export-openapi packages/api-client/openapi.json && pnpm --filter @ass/api-client run generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
