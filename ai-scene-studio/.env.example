# Copier en .env pour docker compose. Ne jamais versionner .env.
# Valeurs de DÉVELOPPEMENT uniquement : l'API refuse ces identifiants en production.

POSTGRES_USER=ass
POSTGRES_PASSWORD=ass
POSTGRES_DB=ass

S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key-change-me
S3_BUCKET=ass-media

# Variables lues par l'API (préfixe ASS_)
ASS_ENVIRONMENT=development
ASS_LOG_LEVEL=INFO
ASS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL de l'API vue depuis le navigateur (figée au build de l'image web)
NEXT_PUBLIC_API_URL=http://localhost:8000
